decChars : Nat → Nat → List Char → List Char
decChars ≡ λ fuel : Nat . λ n : Nat . λ acc : List Char . case fuel of
  | zero ⇒ acc
  | succ f ⇒ (case acnLtNat n 10 of
    | true ⇒ cons (mkChar (acnPlusNat 48 n)) acc
    | false ⇒ decChars f (acnDivNat n 10) (cons (mkChar (acnPlusNat 48 (acnModNat n 10))) acc))

nameOf : Nat → List Char
nameOf ≡ λ n : Nat . cons (mkChar 76) (decChars 12 n nil)

plusNm : List Char
plusNm ≡ cons (mkChar 112) (cons (mkChar 108) (cons (mkChar 117) (cons (mkChar 115) nil)))

multNm : List Char
multNm ≡ cons (mkChar 109) (cons (mkChar 117) (cons (mkChar 108) (cons (mkChar 116) nil)))

minusNm : List Char
minusNm ≡ cons (mkChar 109) (cons (mkChar 105) (cons (mkChar 110) (cons (mkChar 117) (cons (mkChar 115) nil))))

isPrimName : List Char → Bool
isPrimName ≡ λ nm : List Char . orB (eqCharList nm plusNm) (orB (eqCharList nm multNm) (orB (eqCharList nm minusNm) (orB (eqCharList nm acnPlusNm) (orB (eqCharList nm acnMultNm) (orB (eqCharList nm acnMinusNm) (orB (eqCharList nm acnLtNm) (orB (eqCharList nm acnEqNm) (orB (eqCharList nm acnDivNm) (eqCharList nm acnModNm)))))))))

zeroNm : List Char
zeroNm ≡ cons (mkChar 122) (cons (mkChar 101) (cons (mkChar 114) (cons (mkChar 111) nil)))

succNm : List Char
succNm ≡ cons (mkChar 115) (cons (mkChar 117) (cons (mkChar 99) (cons (mkChar 99) nil)))

trueNm : List Char
trueNm ≡ cons (mkChar 116) (cons (mkChar 114) (cons (mkChar 117) (cons (mkChar 101) nil)))

falseNm : List Char
falseNm ≡ cons (mkChar 102) (cons (mkChar 97) (cons (mkChar 108) (cons (mkChar 115) (cons (mkChar 101) nil))))

isNullaryCtor : List Char → Bool
isNullaryCtor ≡ λ nm : List Char . orB (eqCharList nm zeroNm) (orB (eqCharList nm trueNm) (eqCharList nm falseNm))

ctorTag : List Char → Nat
ctorTag ≡ λ nm : List Char . case eqCharList nm succNm of
  | true ⇒ 1
  | false ⇒ (case eqCharList nm falseNm of
    | true ⇒ 1
    | false ⇒ zero)

inductive CgO : Type where
