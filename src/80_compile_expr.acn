writeSeq : Nat → List Chunk2
writeSeq ≡ λ d : Nat . cons (c2Bytes (b3 72 137 194)) (cons (c2Bytes (cons (mkChar 72) (cons (mkChar 139) (slotRM 77 d)))) (cons (c2Call wfFnNm) nil))

eqclSeq : Nat → List Chunk2
eqclSeq ≡ λ d : Nat . cons (c2Bytes (b3 72 137 194)) (cons (c2Bytes (cons (mkChar 72) (cons (mkChar 139) (slotRM 77 d)))) (cons (c2Call eqclFnNm) nil))

