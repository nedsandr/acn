            | false ⇒ cons (c2Bytes (cons (mkChar 72) (cons (mkChar 139) (slotRM 77 d)))) (cons (c2Bytes (b3 72 57 193)) (cons (c2Bytes (b3 15 149 192)) (cons (c2Bytes (b3 15 182 192)) (nil)))))))))

isThreeN : Nat → Bool
isThreeN ≡ λ n : Nat . case n of
  | zero ⇒ false
  | succ k ⇒ (case k of
    | zero ⇒ false
    | succ j ⇒ (case j of
      | zero ⇒ false
      | succ i ⇒ (case i of
        | zero ⇒ true
        | succ h ⇒ false)))

ctorBox3 : List CtorReg → List (List Char) → Nat → Nat → Nat → Expr → Expr → Expr → List Chunk2 → CgO
ctorBox3 ≡ λ reg : List CtorReg . λ env : List (List Char) . λ d : Nat . λ cnt : Nat . λ tag : Nat . λ a1 : Expr . λ a2 : Expr . λ a3 : Expr . λ acc : List Chunk2 . case compileE reg env d cnt a1 nil of
  | mkCgO ch1 c1 fns1 ⇒ (case compileE reg env (acnSuccNat d) c1 a2 nil of
    | mkCgO ch2 c2 fns2 ⇒ (case compileE reg env (acnSuccNat (acnSuccNat d)) c2 a3 (cons (spillSlot (acnSuccNat (acnSuccNat d))) (append2 (allocBytes 32) (cons (storeTagB tag) (cons (movRdxSlot d) (cons (c2Bytes (b4 72 137 80 8)) (cons (movRdxSlot (acnSuccNat d)) (cons (c2Bytes (b4 72 137 80 16)) (cons (movRdxSlot (acnSuccNat (acnSuccNat d))) (cons (c2Bytes (b4 72 137 80 24)) acc))))))))) of
      | mkCgO ch3 c3 fns3 ⇒ mkCgO (append2 ch1 (cons (spillSlot d) (append2 ch2 (cons (spillSlot (acnSuccNat d)) ch3)))) c3 (append2 fns1 (append2 fns2 fns3))))

isFourN : Nat → Bool
isFourN ≡ λ n : Nat . case n of
  | zero ⇒ false
  | succ a ⇒ (case a of
    | zero ⇒ false
    | succ b ⇒ (case b of
      | zero ⇒ false
      | succ c ⇒ (case c of
        | zero ⇒ false
        | succ e ⇒ (case e of
          | zero ⇒ true
          | succ g ⇒ false))))

ctorBox4 : List CtorReg → List (List Char) → Nat → Nat → Nat → Expr → Expr → Expr → Expr → List Chunk2 → CgO
ctorBox4 ≡ λ reg : List CtorReg . λ env : List (List Char) . λ d : Nat . λ cnt : Nat . λ tag : Nat . λ a1 : Expr . λ a2 : Expr . λ a3 : Expr . λ a4 : Expr . λ acc : List Chunk2 . case compileE reg env d cnt a1 nil of
  | mkCgO ch1 c1 fns1 ⇒ (case compileE reg env (acnSuccNat d) c1 a2 nil of
    | mkCgO ch2 c2 fns2 ⇒ (case compileE reg env (acnSuccNat (acnSuccNat d)) c2 a3 nil of
      | mkCgO ch3 c3 fns3 ⇒ (case compileE reg env (acnSuccNat (acnSuccNat (acnSuccNat d))) c3 a4 (cons (spillSlot (acnSuccNat (acnSuccNat (acnSuccNat d)))) (append2 (allocBytes 40) (cons (storeTagB tag) (cons (movRdxSlot d) (cons (c2Bytes (b4 72 137 80 8)) (cons (movRdxSlot (acnSuccNat d)) (cons (c2Bytes (b4 72 137 80 16)) (cons (movRdxSlot (acnSuccNat (acnSuccNat d))) (cons (c2Bytes (b4 72 137 80 24)) (cons (movRdxSlot (acnSuccNat (acnSuccNat (acnSuccNat d)))) (cons (c2Bytes (b4 72 137 80 32)) acc))))))))))) of
        | mkCgO ch4 c4 fns4 ⇒ mkCgO (append2 ch1 (cons (spillSlot d) (append2 ch2 (cons (spillSlot (acnSuccNat d)) (append2 ch3 (cons (spillSlot (acnSuccNat (acnSuccNat d))) ch4)))))) c4 (append2 fns1 (append2 fns2 (append2 fns3 fns4))))))
