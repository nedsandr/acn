        | mkCgO restCh c2 fns2 ⇒ mkCgO (cons (c2Bytes (b4 72 131 250 (regTag reg (branchName b)))) (cons (c2Bytes (cons (mkChar 15) (cons (mkChar 133) (le4 (acnPlusNat (chunks2Len seg) 5))))) (append2 seg (cons (c2Bytes (cons (mkChar 233) (le4 (chunks2Len restCh)))) restCh)))) c2 (append2 fns1 fns2))))

caseBox : List CtorReg → List (List Char) → Nat → Nat → Expr → List CaseBranch → List Chunk2 → CgO
caseBox ≡ λ reg : List CtorReg . λ env : List (List Char) . λ d : Nat . λ cnt : Nat . λ scr : Expr . λ brs : List CaseBranch . λ acc : List Chunk2 . case compileE reg env d cnt scr nil of
  | mkCgO chS cS fnsS ⇒ (case caseBoxBranches reg env d cS brs of
    | mkCgO disp c fnsB ⇒ mkCgO (append2 chS (cons (c2Bytes (b3 72 139 16)) (cons (spillSlot d) (append2 disp acc)))) c (append2 fnsS fnsB))

inductive CtorReg : Type where
  | mkCReg : List Char → Nat → Nat → CtorReg

arityOfType : Expr → Nat
arityOfType ≡ λ e : Expr . case e of
  | eArrow a b ⇒ acnSuccNat (arityOfType b)
  | ePi x t b ⇒ acnSuccNat (arityOfType b)
  | eVar x ⇒ zero
  | eApp f a ⇒ zero
  | eLam x t b ⇒ zero
  | eLamNoTy x b ⇒ zero
  | eType n ⇒ zero
  | eNum n ⇒ zero
  | eCase s brs ⇒ zero

buildRegFrom : Nat → List Ctor → List CtorReg
buildRegFrom ≡ λ tag : Nat . λ ctors : List Ctor . case ctors of
  | nil ⇒ nil
  | cons c rest ⇒ cons (mkCReg (ctorName c) tag (arityOfType (ctorType c))) (buildRegFrom (acnSuccNat tag) rest)

appendReg : List CtorReg → List CtorReg → List CtorReg
appendReg ≡ λ a : List CtorReg . λ b : List CtorReg . case a of
  | nil ⇒ b
  | cons h t ⇒ cons h (appendReg t b)

regFromDecls : List Decl → List CtorReg
regFromDecls ≡ λ decls : List Decl . case decls of
  | nil ⇒ nil
  | cons d rest ⇒ (case d of
    | dDef nm ty body ⇒ regFromDecls rest
    | dSig nm ty ⇒ regFromDecls rest
    | dInd nm params kind ctors ⇒ appendReg (buildRegFrom zero ctors) (regFromDecls rest))

regHas : List CtorReg → List Char → Bool
regHas ≡ λ reg : List CtorReg . λ nm : List Char . case reg of
  | nil ⇒ false
  | cons h t ⇒ (case h of
    | mkCReg n tg ar ⇒ (case eqCharList n nm of
      | true ⇒ true
      | false ⇒ regHas t nm))

regTag : List CtorReg → List Char → Nat
regTag ≡ λ reg : List CtorReg . λ nm : List Char . case reg of
  | nil ⇒ zero
  | cons h t ⇒ (case h of
    | mkCReg n tg ar ⇒ (case eqCharList n nm of
      | true ⇒ tg
      | false ⇒ regTag t nm))

regArity : List CtorReg → List Char → Nat
regArity ≡ λ reg : List CtorReg . λ nm : List Char . case reg of
  | nil ⇒ zero
  | cons h t ⇒ (case h of
    | mkCReg n tg ar ⇒ (case eqCharList n nm of
      | true ⇒ ar
      | false ⇒ regArity t nm))

isZeroN : Nat → Bool
isZeroN ≡ λ n : Nat . case n of
  | zero ⇒ true
  | succ k ⇒ false

isOneN : Nat → Bool
isOneN ≡ λ n : Nat . case n of
  | zero ⇒ false
  | succ k ⇒ (case k of
    | zero ⇒ true
    | succ j ⇒ false)

isTwoN : Nat → Bool
isTwoN ≡ λ n : Nat . case n of
  | zero ⇒ false
  | succ k ⇒ (case k of
    | zero ⇒ false
    | succ j ⇒ (case j of
      | zero ⇒ true
      | succ i ⇒ false))

isUnboxedName : List Char → Bool
isUnboxedName ≡ λ nm : List Char . orB (eqCharList nm zeroNm) (orB (eqCharList nm succNm) (orB (eqCharList nm trueNm) (eqCharList nm falseNm)))

defsFromDecls : List Decl → List TopDef
defsFromDecls ≡ λ decls : List Decl . case decls of
  | nil ⇒ nil
  | cons d rest ⇒ (case d of
    | dDef nm ty body ⇒ cons (mkDef nm body) (defsFromDecls rest)
    | dSig nm ty ⇒ defsFromDecls rest
    | dInd nm ps k cs ⇒ defsFromDecls rest)

compileFile : List Decl → List Char
compileFile ≡ λ decls : List Decl . compileProgram (regFromDecls decls) (defsFromDecls decls)

compileSource : List Char → List Char
compileSource ≡ λ src : List Char . case parseFile (lexAll src) of
  | pOk decls rest ⇒ compileFile decls
  | pErr msg ⇒ nil
acnPlusNm : List Char
acnPlusNm ≡ cons (mkChar 97) (cons (mkChar 99) (cons (mkChar 110) (cons (mkChar 80) (cons (mkChar 108) (cons (mkChar 117) (cons (mkChar 115) (cons (mkChar 78) (cons (mkChar 97) (cons (mkChar 116) (nil))))))))))

acnMultNm : List Char
acnMultNm ≡ cons (mkChar 97) (cons (mkChar 99) (cons (mkChar 110) (cons (mkChar 77) (cons (mkChar 117) (cons (mkChar 108) (cons (mkChar 116) (cons (mkChar 78) (cons (mkChar 97) (cons (mkChar 116) (nil))))))))))

acnMinusNm : List Char
acnMinusNm ≡ cons (mkChar 97) (cons (mkChar 99) (cons (mkChar 110) (cons (mkChar 77) (cons (mkChar 105) (cons (mkChar 110) (cons (mkChar 117) (cons (mkChar 115) (cons (mkChar 78) (cons (mkChar 97) (cons (mkChar 116) (nil)))))))))))

acnLtNm : List Char
acnLtNm ≡ cons (mkChar 97) (cons (mkChar 99) (cons (mkChar 110) (cons (mkChar 76) (cons (mkChar 116) (cons (mkChar 78) (cons (mkChar 97) (cons (mkChar 116) (nil))))))))

acnEqNm : List Char
acnEqNm ≡ cons (mkChar 97) (cons (mkChar 99) (cons (mkChar 110) (cons (mkChar 69) (cons (mkChar 113) (cons (mkChar 78) (cons (mkChar 97) (cons (mkChar 116) (nil))))))))

acnSuccNm : List Char
acnSuccNm ≡ cons (mkChar 97) (cons (mkChar 99) (cons (mkChar 110) (cons (mkChar 83) (cons (mkChar 117) (cons (mkChar 99) (cons (mkChar 99) (cons (mkChar 78) (cons (mkChar 97) (cons (mkChar 116) (nil))))))))))

acnDivNm : List Char
acnDivNm ≡ cons (mkChar 97) (cons (mkChar 99) (cons (mkChar 110) (cons (mkChar 68) (cons (mkChar 105) (cons (mkChar 118) (cons (mkChar 78) (cons (mkChar 97) (cons (mkChar 116) (nil)))))))))

acnModNm : List Char
acnModNm ≡ cons (mkChar 97) (cons (mkChar 99) (cons (mkChar 110) (cons (mkChar 77) (cons (mkChar 111) (cons (mkChar 100) (cons (mkChar 78) (cons (mkChar 97) (cons (mkChar 116) (nil)))))))))

primSeq : List Char → Nat → List Chunk2
primSeq ≡ λ nm : List Char . λ d : Nat . case orB (eqCharList nm plusNm) (eqCharList nm acnPlusNm) of
  | true ⇒ cons (c2Bytes (cons (mkChar 72) (cons (mkChar 3) (slotRM 69 d)))) nil
  | false ⇒ (case orB (eqCharList nm multNm) (eqCharList nm acnMultNm) of
    | true ⇒ cons (c2Bytes (cons (mkChar 72) (cons (mkChar 15) (cons (mkChar 175) (slotRM 69 d))))) nil
    | false ⇒ (case orB (eqCharList nm minusNm) (eqCharList nm acnMinusNm) of
      | true ⇒ cons (c2Bytes (cons (mkChar 72) (cons (mkChar 139) (slotRM 77 d)))) (cons (c2Bytes (b3 72 41 193)) (cons (c2Bytes (b3 72 137 200)) (cons (c2Bytes (b3 72 49 201)) (cons (c2Bytes (b4 72 15 72 193)) (nil)))))
      | false ⇒ (case eqCharList nm acnDivNm of
        | true ⇒ cons (c2Bytes (b3 72 137 193)) (cons (c2Bytes (cons (mkChar 72) (cons (mkChar 139) (slotRM 69 d)))) (cons (c2Bytes (b3 72 133 201)) (cons (c2Bytes (cons (mkChar 15) (cons (mkChar 132) (le4 11)))) (cons (c2Bytes (b3 72 49 210)) (cons (c2Bytes (b3 72 247 241)) (cons (c2Bytes (cons (mkChar 233) (le4 2))) (cons (c2Bytes (b2 49 192)) (nil))))))))
        | false ⇒ (case eqCharList nm acnModNm of
          | true ⇒ cons (c2Bytes (b3 72 137 193)) (cons (c2Bytes (cons (mkChar 72) (cons (mkChar 139) (slotRM 69 d)))) (cons (c2Bytes (b3 72 133 201)) (cons (c2Bytes (cons (mkChar 15) (cons (mkChar 132) (le4 14)))) (cons (c2Bytes (b3 72 49 210)) (cons (c2Bytes (b3 72 247 241)) (cons (c2Bytes (b3 72 137 208)) (cons (c2Bytes (cons (mkChar 233) (le4 2))) (cons (c2Bytes (b2 49 192)) (nil)))))))))
          | false ⇒ (case eqCharList nm acnLtNm of
