ctorSucc ≡ λ reg : List CtorReg . λ env : List (List Char) . λ d : Nat . λ cnt : Nat . λ a : Expr . λ acc : List Chunk2 . case compileE reg env d cnt a (cons (c2Bytes (b4 72 131 192 1)) acc) of
  | mkCgO cha ca fnsa ⇒ mkCgO cha ca fnsa

consArgs : List (List Char) → List (List Char) → List (List Char)
consArgs ≡ λ args : List (List Char) . λ env : List (List Char) . case args of
  | nil ⇒ env
  | cons h t ⇒ consArgs t (cons h env)

branchBind : Nat → List (List Char) → List Chunk2
branchBind ≡ λ d : Nat . λ args : List (List Char) . case args of
  | nil ⇒ nil
  | cons h t ⇒ cons (c2Bytes (cons (mkChar 72) (cons (mkChar 139) (slotRM 69 d)))) (cons subRax1 (cons (c2Bytes (b3 73 137 192)) (cons (c2Bytes (b4 76 139 77 248)) (append2 allocSeq (cons (c2Bytes (b3 76 137 0)) (cons (c2Bytes (b4 76 137 72 8)) (cons (c2Bytes (b4 72 137 69 248)) nil)))))))

branchCode : List CtorReg → List (List Char) → Nat → Nat → CaseBranch → CgO
branchCode ≡ λ reg : List CtorReg . λ env : List (List Char) . λ d : Nat . λ cnt : Nat . λ br : CaseBranch . case compileE reg (consArgs (branchArgs br) env) (acnSuccNat d) cnt (branchBody br) nil of
  | mkCgO bch bc bfns ⇒ mkCgO (append2 (branchBind d (branchArgs br)) bch) bc bfns

caseE : List CtorReg → List (List Char) → Nat → Nat → Expr → CaseBranch → CaseBranch → List Chunk2 → CgO
caseE ≡ λ reg : List CtorReg . λ env : List (List Char) . λ d : Nat . λ cnt : Nat . λ scr : Expr . λ b0 : CaseBranch . λ b1 : CaseBranch . λ acc : List Chunk2 . case compileE reg env d cnt scr nil of
  | mkCgO chS cS fnsS ⇒ (case branchCode reg env d cS b0 of
    | mkCgO seg0 c1 fns0 ⇒ (case branchCode reg env d c1 b1 of
      | mkCgO seg1 c2 fns1 ⇒ mkCgO (append2 chS (cons (spillSlot d) (cons (c2Bytes (b4 72 131 248 (ctorTag (branchName b0)))) (cons (c2Bytes (cons (mkChar 15) (cons (mkChar 133) (le4 (acnPlusNat (chunks2Len seg0) 5))))) (append2 seg0 (cons (c2Bytes (cons (mkChar 233) (le4 (chunks2Len seg1)))) (append2 seg1 acc))))))) c2 (append2 fnsS (append2 fns0 fns1))))

compileE : List CtorReg → List (List Char) → Nat → Nat → Expr → List Chunk2 → CgO
compileE ≡ λ reg : List CtorReg . λ env : List (List Char) . λ d : Nat . λ cnt : Nat . λ e : Expr . λ acc : List Chunk2 . case e of
  | eNum n ⇒ mkCgO (cons (c2Bytes (cons (mkChar 184) (le4 n))) acc) cnt nil
  | eVar x ⇒ (case isNullaryCtor x of
    | true ⇒ mkCgO (cons (c2Bytes (cons (mkChar 184) (le4 (ctorTag x)))) acc) cnt nil
    | false ⇒ (case andB (regHas reg x) (isZeroN (regArity reg x)) of
      | true ⇒ mkCgO (append2 (ctorBox0 (regTag reg x)) acc) cnt nil
      | false ⇒ (case inEnv env x of
        | true ⇒ mkCgO (append2 (envGet (envIndex env x)) acc) cnt nil
        | false ⇒ mkCgO (cons (c2Call x) acc) cnt nil)))
  | eType n ⇒ mkCgO (cons (c2Bytes (cons (mkChar 184) (le4 zero))) acc) cnt nil
  | ePi x t b ⇒ mkCgO acc cnt nil
  | eArrow a b ⇒ mkCgO acc cnt nil
  | eLam x t body ⇒ (case compileE reg (cons x env) zero (acnSuccNat cnt) body lamEpilog of
    | mkCgO bch bcnt bfns ⇒ mkCgO (append2 (closureSite (nameOf cnt)) acc) bcnt (cons (mkFn2 (nameOf cnt) (append2 lamProlog bch)) bfns))
  | eLamNoTy x body ⇒ (case compileE reg (cons x env) zero (acnSuccNat cnt) body lamEpilog of
    | mkCgO bch bcnt bfns ⇒ mkCgO (append2 (closureSite (nameOf cnt)) acc) bcnt (cons (mkFn2 (nameOf cnt) (append2 lamProlog bch)) bfns))
  | eApp f a ⇒ (case f of
    | eApp h a1 ⇒ (case h of
      | eVar p ⇒ (case eqCharList p acnWriteFileNm of
        | true ⇒ (case compileE reg env d cnt a1 nil of
          | mkCgO wch1 wc1 wfns1 ⇒ (case compileE reg env (acnSuccNat d) wc1 a (append2 (writeSeq d) acc) of
            | mkCgO wch2 wc2 wfns2 ⇒ mkCgO (append2 wch1 (cons (spillSlot d) wch2)) wc2 (append2 wfns1 wfns2)))
        | false ⇒ (case eqCharList p acnEqCharListNm of
        | true ⇒ (case compileE reg env d cnt a1 nil of
          | mkCgO qch1 qc1 qfns1 ⇒ (case compileE reg env (acnSuccNat d) qc1 a (append2 (eqclSeq d) acc) of
            | mkCgO qch2 qc2 qfns2 ⇒ mkCgO (append2 qch1 (cons (spillSlot d) qch2)) qc2 (append2 qfns1 qfns2)))
        | false ⇒ (case isPrimName p of
        | true ⇒ (case compileE reg env d cnt a1 nil of
          | mkCgO ch1 c1 fns1 ⇒ (case compileE reg env (acnSuccNat d) c1 a (append2 (primSeq p d) acc) of
            | mkCgO ch2 c2 fns2 ⇒ mkCgO (append2 ch1 (cons (c2Bytes (cons (mkChar 72) (cons (mkChar 137) (slotRM 69 d)))) ch2)) c2 (append2 fns1 fns2)))
        | false ⇒ (case andB (regHas reg p) (isTwoN (regArity reg p)) of
          | true ⇒ ctorBox2 reg env d cnt (regTag reg p) a1 a acc
          | false ⇒ compileApp reg env d cnt f a acc))))
      | eApp g1 g2 ⇒ (case g1 of
        | eVar p ⇒ (case andB (regHas reg p) (isThreeN (regArity reg p)) of
          | true ⇒ ctorBox3 reg env d cnt (regTag reg p) g2 a1 a acc
          | false ⇒ compileApp reg env d cnt f a acc)
        | eApp gg1 gg2 ⇒ (case gg1 of
          | eVar p ⇒ (case andB (regHas reg p) (isFourN (regArity reg p)) of
            | true ⇒ ctorBox4 reg env d cnt (regTag reg p) gg2 g2 a1 a acc
            | false ⇒ compileApp reg env d cnt f a acc)
          | eApp hh1 hh2 ⇒ compileApp reg env d cnt f a acc
          | eLam hx ht hb ⇒ compileApp reg env d cnt f a acc
          | eLamNoTy hx hb ⇒ compileApp reg env d cnt f a acc
          | ePi hx ht hb ⇒ compileApp reg env d cnt f a acc
          | eArrow ha hb ⇒ compileApp reg env d cnt f a acc
          | eType hn ⇒ compileApp reg env d cnt f a acc
          | eNum hn ⇒ compileApp reg env d cnt f a acc
          | eCase hs hb ⇒ compileApp reg env d cnt f a acc)
        | eLam gx gt gb ⇒ compileApp reg env d cnt f a acc
        | eLamNoTy gx gb ⇒ compileApp reg env d cnt f a acc
        | ePi gx gt gb ⇒ compileApp reg env d cnt f a acc
        | eArrow ga gb ⇒ compileApp reg env d cnt f a acc
        | eType gn ⇒ compileApp reg env d cnt f a acc
        | eNum gn ⇒ compileApp reg env d cnt f a acc
        | eCase gs gb ⇒ compileApp reg env d cnt f a acc)
      | eLam vx vt vb ⇒ compileApp reg env d cnt f a acc
      | eLamNoTy vx vb ⇒ compileApp reg env d cnt f a acc
      | ePi vx vt vb ⇒ compileApp reg env d cnt f a acc
      | eArrow va vb ⇒ compileApp reg env d cnt f a acc
      | eType vn ⇒ compileApp reg env d cnt f a acc
      | eNum vn ⇒ compileApp reg env d cnt f a acc
      | eCase vs vb ⇒ compileApp reg env d cnt f a acc)
    | eVar q ⇒ (case eqCharList q acnReadFileNm of
      | true ⇒ (case compileE reg env d cnt a (cons (c2Bytes (b3 72 137 193)) (cons (c2Call rdFnNm) acc)) of
        | mkCgO rcha rca rfnsa ⇒ mkCgO rcha rca rfnsa)
      | false ⇒ (case orB (eqCharList q succNm) (eqCharList q acnSuccNm) of
      | true ⇒ ctorSucc reg env d cnt a acc
      | false ⇒ (case andB (regHas reg q) (isOneN (regArity reg q)) of
        | true ⇒ ctorBox1 reg env d cnt (regTag reg q) a acc
        | false ⇒ compileApp reg env d cnt f a acc)))
    | eNum q ⇒ compileApp reg env d cnt f a acc
    | eLam q t b ⇒ compileApp reg env d cnt f a acc
    | eLamNoTy q b ⇒ compileApp reg env d cnt f a acc
    | ePi q t b ⇒ compileApp reg env d cnt f a acc
    | eArrow q b ⇒ compileApp reg env d cnt f a acc
    | eType q ⇒ compileApp reg env d cnt f a acc
    | eCase q b ⇒ compileApp reg env d cnt f a acc)
  | eCase scr brs ⇒ (case brs of
    | nil ⇒ mkCgO acc cnt nil
    | cons b0 rest ⇒ (case andB (regHas reg (branchName b0)) (notB (isUnboxedName (branchName b0))) of
      | true ⇒ caseBox reg env d cnt scr brs acc
      | false ⇒ (case rest of
        | nil ⇒ mkCgO acc cnt nil
        | cons b1 rest2 ⇒ caseE reg env d cnt scr b0 b1 acc)))

