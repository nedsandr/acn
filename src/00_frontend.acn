  | tNum n ⇒ false

isCol : Token → Bool
isCol ≡ λ t : Token . case t of
  | tColon ⇒ true
  | tEOF ⇒ false
  | tLParen ⇒ false
  | tRParen ⇒ false
  | tDot ⇒ false
  | tComma ⇒ false
  | tPipe ⇒ false
  | tEquiv ⇒ false
  | tArrow ⇒ false
  | tDArrow ⇒ false
