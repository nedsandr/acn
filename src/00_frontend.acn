inductive Empty : Type where

inductive Unit : Type where
  | star : Unit


inductive Bool : Type where
  | true : Bool
  | false : Bool

notB : Bool → Bool
notB ≡ λ b : Bool . case b of
  | true ⇒ false
  | false ⇒ true

andB : Bool → Bool → Bool
andB ≡ λ a : Bool . λ b : Bool . case a of
  | true ⇒ b
  | false ⇒ false

orB : Bool → Bool → Bool
orB ≡ λ a : Bool . λ b : Bool . case a of
  | true ⇒ true
  | false ⇒ b

xorB : Bool → Bool → Bool
xorB ≡ λ a : Bool . λ b : Bool . case a of
  | true ⇒ notB b
  | false ⇒ b


inductive Nat : Type where
  | zero : Nat
  | succ : Nat → Nat

acnPlusNat : Nat → Nat → Nat

acnMultNat : Nat → Nat → Nat

acnMinusNat : Nat → Nat → Nat

plus : Nat → Nat → Nat
plus ≡ λ a : Nat . λ b : Nat . acnPlusNat a b

mult : Nat → Nat → Nat
mult ≡ λ a : Nat . λ b : Nat . acnMultNat a b

minus : Nat → Nat → Nat
minus ≡ λ a : Nat . λ b : Nat . acnMinusNat a b

acnEqNat : Nat → Nat → Bool

acnLtNat : Nat → Nat → Bool

eqN : Nat → Nat → Bool
eqN ≡ λ a : Nat . λ b : Nat . acnEqNat a b

ltN : Nat → Nat → Bool
ltN ≡ λ a : Nat . λ b : Nat . acnLtNat a b

leN : Nat → Nat → Bool
leN ≡ λ a : Nat . λ b : Nat . orB (ltN a b) (eqN a b)

geN : Nat → Nat → Bool
geN ≡ λ a : Nat . λ b : Nat . notB (ltN a b)

gtN : Nat → Nat → Bool
gtN ≡ λ a : Nat . λ b : Nat . ltN b a


inductive Pair (A : Type) (B : Type) : Type where
  | mkPair : A → B → Pair A B

pairFst : (A : Type) → (B : Type) → Pair A B → A
pairFst ≡ λ A : Type . λ B : Type . λ p : Pair A B . case p of
  | mkPair a b ⇒ a

pairSnd : (A : Type) → (B : Type) → Pair A B → B
pairSnd ≡ λ A : Type . λ B : Type . λ p : Pair A B . case p of
  | mkPair a b ⇒ b


inductive Sum (A : Type) (B : Type) : Type where
  | inlS : A → Sum A B
  | inrS : B → Sum A B

caseSum : (A : Type) → (B : Type) → (C : Type) → (A → C) → (B → C) → Sum A B → C
caseSum ≡ λ A : Type . λ B : Type . λ C : Type . λ f : A → C . λ g : B → C . λ s : Sum A B . case s of
  | inlS a ⇒ f a
  | inrS b ⇒ g b


inductive Option (A : Type) : Type where
  | none : Option A
  | some : A → Option A

mapO : (A : Type) → (B : Type) → (A → B) → Option A → Option B
mapO ≡ λ A : Type . λ B : Type . λ f : A → B . λ o : Option A . case o of
  | none ⇒ none
  | some a ⇒ some (f a)

isSome : (A : Type) → Option A → Bool
isSome ≡ λ A : Type . λ o : Option A . case o of
  | none ⇒ false
  | some a ⇒ true

isNone : (A : Type) → Option A → Bool
isNone ≡ λ A : Type . λ o : Option A . case o of
  | none ⇒ true
  | some a ⇒ false


inductive List (A : Type) : Type where
  | nil : List A
  | cons : A → List A → List A

length : (A : Type) → List A → Nat
length ≡ λ A : Type . λ xs : List A . case xs of
  | nil ⇒ zero
  | cons h t ⇒ succ (length A t)

mapL : (A : Type) → (B : Type) → (A → B) → List A → List B
mapL ≡ λ A : Type . λ B : Type . λ f : A → B . λ xs : List A . case xs of
  | nil ⇒ nil
  | cons h t ⇒ cons (f h) (mapL A B f t)

append : (A : Type) → List A → List A → List A
append ≡ λ A : Type . λ xs : List A . λ ys : List A . case xs of
  | nil ⇒ ys
  | cons h t ⇒ cons h (append A t ys)

foldr : (A : Type) → (B : Type) → (A → B → B) → B → List A → B
foldr ≡ λ A : Type . λ B : Type . λ f : A → B → B . λ z : B . λ xs : List A . case xs of
  | nil ⇒ z
  | cons h t ⇒ f h (foldr A B f z t)

foldl : (A : Type) → (B : Type) → (B → A → B) → B → List A → B
foldl ≡ λ A : Type . λ B : Type . λ f : B → A → B . λ z : B . λ xs : List A . case xs of
  | nil ⇒ z
  | cons h t ⇒ foldl A B f (f z h) t

reverse : (A : Type) → List A → List A
reverse ≡ λ A : Type . λ xs : List A . foldl A (List A) (λ acc : List A . λ x : A . cons x acc) nil xs

filterL : (A : Type) → (A → Bool) → List A → List A
filterL ≡ λ A : Type . λ p : A → Bool . λ xs : List A . case xs of
  | nil ⇒ nil
  | cons h t ⇒ (case p h of
    | true ⇒ cons h (filterL A p t)
    | false ⇒ filterL A p t)

anyL : (A : Type) → (A → Bool) → List A → Bool
anyL ≡ λ A : Type . λ p : A → Bool . λ xs : List A . case xs of
  | nil ⇒ false
  | cons h t ⇒ orB (p h) (anyL A p t)

allL : (A : Type) → (A → Bool) → List A → Bool
allL ≡ λ A : Type . λ p : A → Bool . λ xs : List A . case xs of
  | nil ⇒ true
  | cons h t ⇒ andB (p h) (allL A p t)


inductive Char : Type where
  | mkChar : Nat → Char

charCode : Char → Nat
charCode ≡ λ c : Char . case c of
  | mkChar n ⇒ n

eqC : Char → Char → Bool
eqC ≡ λ a : Char . λ b : Char . eqN (charCode a) (charCode b)


inductive String : Type where
  | mkString : List Char → String

strChars : String → List Char
strChars ≡ λ s : String . case s of
  | mkString cs ⇒ cs

strLength : String → Nat
strLength ≡ λ s : String . length Char (strChars s)

strAppend : String → String → String
strAppend ≡ λ a : String . λ b : String . mkString (append Char (strChars a) (strChars b))

acnEqCharList : List Char → List Char → Bool

acnSuccNat : Nat → Nat

eqCharList : List Char → List Char → Bool
eqCharList ≡ λ a : List Char . λ b : List Char . acnEqCharList a b

eqStr : String → String → Bool
eqStr ≡ λ a : String . λ b : String . eqCharList (strChars a) (strChars b)



isSpaceCh : Char → Bool
isSpaceCh ≡ λ c : Char . orB (eqN (charCode c) 32) (orB (eqN (charCode c) 10) (orB (eqN (charCode c) 13) (eqN (charCode c) 9)))

isDigitCh : Char → Bool
isDigitCh ≡ λ c : Char . andB (leN 48 (charCode c)) (leN (charCode c) 57)

isAlphaLowerCh : Char → Bool
isAlphaLowerCh ≡ λ c : Char . andB (leN 97 (charCode c)) (leN (charCode c) 122)

isAlphaUpperCh : Char → Bool
isAlphaUpperCh ≡ λ c : Char . andB (leN 65 (charCode c)) (leN (charCode c) 90)

isAlphaCh : Char → Bool
isAlphaCh ≡ λ c : Char . orB (isAlphaLowerCh c) (isAlphaUpperCh c)

isAlnumCh : Char → Bool
isAlnumCh ≡ λ c : Char . orB (isAlphaCh c) (isDigitCh c)


inductive Token : Type where
  | tEOF : Token
  | tLParen : Token
  | tRParen : Token
  | tColon : Token
  | tDot : Token
  | tComma : Token
  | tPipe : Token
  | tEquiv : Token
  | tArrow : Token
  | tDArrow : Token
  | tLambda : Token
  | tType : Token
  | tInductive : Token
  | tCoinductive : Token
  | tWhere : Token
  | tCase : Token
  | tOf : Token
  | tIdent : List Char → Token
  | tNum : Nat → Token


decodeUtf8One : List Nat → Pair Char (List Nat)
decodeUtf8One ≡ λ bytes : List Nat . case bytes of
  | nil ⇒ mkPair (mkChar zero) nil
  | cons b1 t1 ⇒ (case ltN b1 128 of
    | true ⇒ mkPair (mkChar b1) t1
    | false ⇒ (case ltN b1 224 of
      | true ⇒ (case t1 of
        | nil ⇒ mkPair (mkChar b1) nil
        | cons b2 t2 ⇒ mkPair (mkChar (plus (mult 64 (minus b1 192)) (minus b2 128))) t2)
      | false ⇒ (case ltN b1 240 of
        | true ⇒ (case t1 of
          | nil ⇒ mkPair (mkChar b1) nil
          | cons b2 t2 ⇒ (case t2 of
            | nil ⇒ mkPair (mkChar b1) nil
            | cons b3 t3 ⇒ mkPair (mkChar (plus (mult 4096 (minus b1 224)) (plus (mult 64 (minus b2 128)) (minus b3 128)))) t3))
        | false ⇒ mkPair (mkChar b1) t1)))

decodeUtf8 : Nat → List Nat → List Char
decodeUtf8 ≡ λ fuel : Nat . λ bytes : List Nat . case fuel of
  | zero ⇒ nil
  | succ f ⇒ (case bytes of
    | nil ⇒ nil
    | cons h t ⇒ (case decodeUtf8One bytes of
      | mkPair ch rest ⇒ cons ch (decodeUtf8 f rest)))


skipSpaces : List Char → List Char
skipSpaces ≡ λ xs : List Char . case xs of
  | nil ⇒ nil
  | cons h t ⇒ (case isSpaceCh h of
    | true ⇒ skipSpaces t
    | false ⇒ xs)

readIdent : List Char → Pair (List Char) (List Char)
readIdent ≡ λ xs : List Char . case xs of
  | nil ⇒ mkPair nil nil
  | cons h t ⇒ (case isAlnumCh h of
    | true ⇒ (case readIdent t of
      | mkPair acc rest ⇒ mkPair (cons h acc) rest)
    | false ⇒ mkPair nil xs)

readDigitsGo : Nat → List Char → Pair Nat (List Char)
readDigitsGo ≡ λ acc : Nat . λ xs : List Char . case xs of
  | nil ⇒ mkPair acc nil
  | cons h t ⇒ (case isDigitCh h of
    | true ⇒ readDigitsGo (acnPlusNat (acnMultNat acc 10) (acnMinusNat (charCode h) 48)) t
    | false ⇒ mkPair acc xs)

readDigits : List Char → Pair Nat (List Char)
readDigits ≡ λ xs : List Char . readDigitsGo zero xs

kwType : List Char
kwType ≡ cons (mkChar 84) (cons (mkChar 121) (cons (mkChar 112) (cons (mkChar 101) nil)))

kwInductive : List Char
kwInductive ≡ cons (mkChar 105) (cons (mkChar 110) (cons (mkChar 100) (cons (mkChar 117) (cons (mkChar 99) (cons (mkChar 116) (cons (mkChar 105) (cons (mkChar 118) (cons (mkChar 101) nil))))))))

kwWhere : List Char
kwWhere ≡ cons (mkChar 119) (cons (mkChar 104) (cons (mkChar 101) (cons (mkChar 114) (cons (mkChar 101) nil))))

kwCase : List Char
kwCase ≡ cons (mkChar 99) (cons (mkChar 97) (cons (mkChar 115) (cons (mkChar 101) nil)))

kwOf : List Char
kwOf ≡ cons (mkChar 111) (cons (mkChar 102) nil)

classifyIdent : List Char → Token
classifyIdent ≡ λ s : List Char . case eqCharList s kwType of
  | true ⇒ tType
  | false ⇒ (case eqCharList s kwInductive of
    | true ⇒ tInductive
    | false ⇒ (case eqCharList s kwWhere of
      | true ⇒ tWhere
      | false ⇒ (case eqCharList s kwCase of
        | true ⇒ tCase
        | false ⇒ (case eqCharList s kwOf of
          | true ⇒ tOf
          | false ⇒ tIdent s))))

lexOneUnicode : Char → Option Token
lexOneUnicode ≡ λ c : Char . case eqN (charCode c) 955 of
  | true ⇒ some tLambda
  | false ⇒ (case eqN (charCode c) 8594 of
    | true ⇒ some tArrow
    | false ⇒ (case eqN (charCode c) 8658 of
      | true ⇒ some tDArrow
      | false ⇒ (case eqN (charCode c) 8801 of
        | true ⇒ some tEquiv
        | false ⇒ none)))

lexOnePunct : Char → Option Token
lexOnePunct ≡ λ c : Char . case eqN (charCode c) 40 of
  | true ⇒ some tLParen
  | false ⇒ (case eqN (charCode c) 41 of
    | true ⇒ some tRParen
    | false ⇒ (case eqN (charCode c) 58 of
      | true ⇒ some tColon
      | false ⇒ (case eqN (charCode c) 46 of
        | true ⇒ some tDot
        | false ⇒ (case eqN (charCode c) 44 of
          | true ⇒ some tComma
          | false ⇒ (case eqN (charCode c) 124 of
            | true ⇒ some tPipe
            | false ⇒ lexOneUnicode c)))))

lexOne : List Char → Pair Token (List Char)
lexOne ≡ λ xs : List Char . case skipSpaces xs of
  | nil ⇒ mkPair tEOF nil
  | cons h t ⇒ (case lexOnePunct h of
    | some tk ⇒ mkPair tk t
    | none ⇒ (case isDigitCh h of
      | true ⇒ (case readDigits (cons h t) of
        | mkPair n rest ⇒ mkPair (tNum n) rest)
      | false ⇒ (case isAlphaCh h of
        | true ⇒ (case readIdent (cons h t) of
          | mkPair s rest ⇒ mkPair (classifyIdent s) rest)
        | false ⇒ mkPair tEOF nil)))

lexAll : List Char → List Token
lexAll ≡ λ xs : List Char . case lexOne xs of
  | mkPair tk rest ⇒ (case tk of
    | tEOF ⇒ cons tEOF nil
    | tLParen ⇒ cons tk (lexAll rest)
    | tRParen ⇒ cons tk (lexAll rest)
    | tColon ⇒ cons tk (lexAll rest)
    | tDot ⇒ cons tk (lexAll rest)
    | tComma ⇒ cons tk (lexAll rest)
    | tPipe ⇒ cons tk (lexAll rest)
    | tEquiv ⇒ cons tk (lexAll rest)
    | tArrow ⇒ cons tk (lexAll rest)
    | tDArrow ⇒ cons tk (lexAll rest)
    | tLambda ⇒ cons tk (lexAll rest)
    | tType ⇒ cons tk (lexAll rest)
    | tInductive ⇒ cons tk (lexAll rest)
    | tCoinductive ⇒ cons tk (lexAll rest)
    | tWhere ⇒ cons tk (lexAll rest)
    | tCase ⇒ cons tk (lexAll rest)
    | tOf ⇒ cons tk (lexAll rest)
    | tIdent s ⇒ cons tk (lexAll rest)
    | tNum n ⇒ cons tk (lexAll rest))


inductive Expr : Type where
  | eVar : List Char → Expr
  | eApp : Expr → Expr → Expr
  | eLam : List Char → Expr → Expr → Expr
  | eLamNoTy : List Char → Expr → Expr
  | ePi : List Char → Expr → Expr → Expr
  | eArrow : Expr → Expr → Expr
  | eType : Nat → Expr
  | eNum : Nat → Expr
  | eCase : Expr → List CaseBranch → Expr

inductive CaseBranch : Type where
  | mkBranch : List Char → List (List Char) → Expr → CaseBranch

inductive Param : Type where
  | mkParam : List Char → Expr → Param

inductive Ctor : Type where
  | mkCtor : List Char → Expr → Ctor

inductive Decl : Type where
  | dDef : List Char → Expr → Expr → Decl
  | dSig : List Char → Expr → Decl
  | dInd : List Char → List Param → Expr → List Ctor → Decl

inductive AcnFile : Type where
  | mkAcnFile : List Decl → AcnFile

countDecls : List Decl → Nat
countDecls ≡ λ ds : List Decl . case ds of
  | nil ⇒ zero
  | cons h t ⇒ succ (countDecls t)

ctorName : Ctor → List Char
ctorName ≡ λ c : Ctor . case c of
  | mkCtor name ty ⇒ name

ctorType : Ctor → Expr
ctorType ≡ λ c : Ctor . case c of
  | mkCtor name ty ⇒ ty

paramName : Param → List Char
paramName ≡ λ p : Param . case p of
  | mkParam name ty ⇒ name

paramType : Param → Expr
paramType ≡ λ p : Param . case p of
  | mkParam name ty ⇒ ty

branchName : CaseBranch → List Char
branchName ≡ λ b : CaseBranch . case b of
  | mkBranch name args body ⇒ name

branchArgs : CaseBranch → List (List Char)
branchArgs ≡ λ b : CaseBranch . case b of
  | mkBranch name args body ⇒ args

branchBody : CaseBranch → Expr
branchBody ≡ λ b : CaseBranch . case b of
  | mkBranch name args body ⇒ body


inductive ParseResult (A : Type) : Type where
  | pOk : A → List Token → ParseResult A
  | pErr : List Char → ParseResult A

peekTok : List Token → Token
peekTok ≡ λ ts : List Token . case ts of
  | nil ⇒ tEOF
  | cons h t ⇒ h

dropTok : List Token → List Token
dropTok ≡ λ ts : List Token . case ts of
  | nil ⇒ nil
  | cons h t ⇒ t

tokGetIdent : Token → Option (List Char)
tokGetIdent ≡ λ t : Token . case t of
  | tEOF ⇒ none
  | tLParen ⇒ none
  | tRParen ⇒ none
  | tColon ⇒ none
  | tDot ⇒ none
  | tComma ⇒ none
  | tPipe ⇒ none
  | tEquiv ⇒ none
  | tArrow ⇒ none
  | tDArrow ⇒ none
  | tLambda ⇒ none
  | tType ⇒ none
  | tInductive ⇒ none
  | tCoinductive ⇒ none
  | tWhere ⇒ none
  | tCase ⇒ none
  | tOf ⇒ none
  | tIdent s ⇒ some s
  | tNum n ⇒ none

tokGetNum : Token → Option Nat
tokGetNum ≡ λ t : Token . case t of
  | tEOF ⇒ none
  | tLParen ⇒ none
  | tRParen ⇒ none
  | tColon ⇒ none
  | tDot ⇒ none
  | tComma ⇒ none
  | tPipe ⇒ none
  | tEquiv ⇒ none
  | tArrow ⇒ none
  | tDArrow ⇒ none
  | tLambda ⇒ none
  | tType ⇒ none
  | tInductive ⇒ none
  | tCoinductive ⇒ none
  | tWhere ⇒ none
  | tCase ⇒ none
  | tOf ⇒ none
  | tIdent s ⇒ none
  | tNum n ⇒ some n

tokIs : (Token → Bool) → Token → Bool
tokIs ≡ λ p : Token → Bool . λ t : Token . p t

isArr : Token → Bool
isArr ≡ λ t : Token . case t of
  | tArrow ⇒ true
  | tEOF ⇒ false
  | tLParen ⇒ false
  | tRParen ⇒ false
  | tColon ⇒ false
  | tDot ⇒ false
  | tComma ⇒ false
  | tPipe ⇒ false
  | tEquiv ⇒ false
  | tDArrow ⇒ false
  | tLambda ⇒ false
  | tType ⇒ false
  | tInductive ⇒ false
  | tCoinductive ⇒ false
  | tWhere ⇒ false
  | tCase ⇒ false
  | tOf ⇒ false
  | tIdent s ⇒ false
  | tNum n ⇒ false

isLP : Token → Bool
isLP ≡ λ t : Token . case t of
  | tLParen ⇒ true
  | tEOF ⇒ false
  | tRParen ⇒ false
  | tColon ⇒ false
  | tDot ⇒ false
  | tComma ⇒ false
  | tPipe ⇒ false
  | tEquiv ⇒ false
  | tArrow ⇒ false
  | tDArrow ⇒ false
  | tLambda ⇒ false
  | tType ⇒ false
  | tInductive ⇒ false
  | tCoinductive ⇒ false
  | tWhere ⇒ false
  | tCase ⇒ false
  | tOf ⇒ false
  | tIdent s ⇒ false
  | tNum n ⇒ false

isRP : Token → Bool
isRP ≡ λ t : Token . case t of
  | tRParen ⇒ true
  | tEOF ⇒ false
  | tLParen ⇒ false
  | tColon ⇒ false
  | tDot ⇒ false
  | tComma ⇒ false
  | tPipe ⇒ false
  | tEquiv ⇒ false
  | tArrow ⇒ false
  | tDArrow ⇒ false
  | tLambda ⇒ false
  | tType ⇒ false
  | tInductive ⇒ false
  | tCoinductive ⇒ false
  | tWhere ⇒ false
  | tCase ⇒ false
  | tOf ⇒ false
  | tIdent s ⇒ false
  | tNum n ⇒ false

isLam : Token → Bool
isLam ≡ λ t : Token . case t of
  | tLambda ⇒ true
  | tEOF ⇒ false
  | tLParen ⇒ false
  | tRParen ⇒ false
  | tColon ⇒ false
  | tDot ⇒ false
  | tComma ⇒ false
  | tPipe ⇒ false
  | tEquiv ⇒ false
  | tArrow ⇒ false
  | tDArrow ⇒ false
  | tType ⇒ false
  | tInductive ⇒ false
  | tCoinductive ⇒ false
  | tWhere ⇒ false
  | tCase ⇒ false
  | tOf ⇒ false
  | tIdent s ⇒ false
  | tNum n ⇒ false

isTy : Token → Bool
isTy ≡ λ t : Token . case t of
  | tType ⇒ true
  | tEOF ⇒ false
  | tLParen ⇒ false
  | tRParen ⇒ false
  | tColon ⇒ false
  | tDot ⇒ false
  | tComma ⇒ false
  | tPipe ⇒ false
  | tEquiv ⇒ false
  | tArrow ⇒ false
  | tDArrow ⇒ false
  | tLambda ⇒ false
  | tInductive ⇒ false
  | tCoinductive ⇒ false
  | tWhere ⇒ false
  | tCase ⇒ false
  | tOf ⇒ false
  | tIdent s ⇒ false
  | tNum n ⇒ false

isDot : Token → Bool
isDot ≡ λ t : Token . case t of
  | tDot ⇒ true
  | tEOF ⇒ false
  | tLParen ⇒ false
  | tRParen ⇒ false
  | tColon ⇒ false
  | tComma ⇒ false
  | tPipe ⇒ false
  | tEquiv ⇒ false
  | tArrow ⇒ false
  | tDArrow ⇒ false
  | tLambda ⇒ false
  | tType ⇒ false
  | tInductive ⇒ false
  | tCoinductive ⇒ false
  | tWhere ⇒ false
  | tCase ⇒ false
  | tOf ⇒ false
