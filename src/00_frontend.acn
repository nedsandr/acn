  | tNum n ⇒ false

isEq : Token → Bool
isEq ≡ λ t : Token . case t of
  | tEquiv ⇒ true
  | tEOF ⇒ false
  | tLParen ⇒ false
  | tRParen ⇒ false
  | tColon ⇒ false
  | tDot ⇒ false
  | tComma ⇒ false
  | tPipe ⇒ false
  | tArrow ⇒ false
  | tDArrow ⇒ false
  | tLambda ⇒ false
  | tType ⇒ false
  | tInductive ⇒ false
  | tCoinductive ⇒ false
  | tWhere ⇒ false
